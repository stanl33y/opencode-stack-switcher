{
  "name": "ocs",
  "version": "0.2.0",
  "description": "OpenCode Stack Switcher — switch model stacks (agents/subagents/categories) and launch opencode",
  "type": "module",
  "files": ["src", "stacks/example.json", "README.md", "LICENSE", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/cli.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "bin": {
    "ocs": "./src/cli.ts"
  },
  "scripts": {
    "ocs": "bun run src/cli.ts",
    "dev": "bun run --watch src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:check": "bun run scripts/check-coverage.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": ["biome check --write"]
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/bun": "1.3.14",
    "husky": "9.1.4",
    "lint-staged": "15.2.2"
  }
}
