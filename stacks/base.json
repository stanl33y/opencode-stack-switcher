{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent"
  ],
  "tools": {
    "webfetch": true,
    "websearch": true,
    "google_search": true,
    "ast_grep_search": true,
    "background_output": true,
    "lsp_diagnostics": true,
    "todoread": true,
    "todowrite": true,
    "task": true,
    "skill": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4000
  },
  "agent": {
    "build": {
      "mode": "primary"
    },
    "plan": {
      "mode": "primary"
    },
    "llama-rtx": {
      "description": "Local RTX agent — long context, file editing, no internet (131K ctx, MTP)",
      "model": "llama-rtx/qwen3.5-4b",
      "mode": "all",
      "prompt": "/no_think You are a local file editing agent. You ONLY use read, write, edit, and glob tools. Never use web search, fetch, or any external tools. When given a task, find the relevant files, read them, make the requested changes, done. Be direct and efficient.",
      "permission": {
        "webfetch": "deny",
        "websearch": "deny",
        "google_search": "deny",
        "ast_grep_search": "deny",
        "lsp_diagnostics": "deny",
        "background_output": "deny",
        "task": "deny",
        "skill": "deny",
        "ui_to_artifact": "deny",
        "extract_text_from_screenshot": "deny",
        "diagnose_error_screenshot": "deny",
        "understand_technical_diagram": "deny",
        "analyze_data_visualization": "deny",
        "ui_diff_check": "deny",
        "image_analysis": "deny",
        "video_analysis": "deny",
        "context7": "deny",
        "grep_app": "deny",
        "lsp": "deny",
        "ast_grep": "deny"
      }
    },
    "llama-igpu": {
      "description": "Local iGPU agent — fast generation, short tasks, no internet (32K ctx)",
      "model": "llama-igpu/qwen3.5-4b",
      "mode": "all",
      "prompt": "/no_think You are a local file editing agent. You ONLY use read, write, edit, and glob tools. Never use web search, fetch, or any external tools. When given a task, find the relevant files, read them, make the requested changes, done. Be direct and efficient.",
      "permission": {
        "webfetch": "deny",
        "websearch": "deny",
        "google_search": "deny",
        "ast_grep_search": "deny",
        "lsp_diagnostics": "deny",
        "background_output": "deny",
        "task": "deny",
        "skill": "deny",
        "ui_to_artifact": "deny",
        "extract_text_from_screenshot": "deny",
        "diagnose_error_screenshot": "deny",
        "understand_technical_diagram": "deny",
        "analyze_data_visualization": "deny",
        "ui_diff_check": "deny",
        "image_analysis": "deny",
        "video_analysis": "deny",
        "context7": "deny",
        "grep_app": "deny",
        "lsp": "deny",
        "ast_grep": "deny"
      }
    }
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_MODE": "ZAI",
        "Z_AI_API_KEY": "$ZAI_API_KEY"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer $ZAI_API_KEY"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer $ZAI_API_KEY"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer $ZAI_API_KEY"
      }
    }
  },
  "provider": {
    "openai": {
      "name": "OpenAI",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "$OPENAI_API_KEY"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5"
        },
        "gpt-5.5-fast": {
          "name": "GPT-5.5 Fast",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    },
    "zai": {
      "models": {
        "glm-4.7": {
          "name": "GLM-4.7 (Z.AI)",
          "limit": {
            "context": 128000,
            "output": 4096
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "name": "Z.AI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "$ZAI_API_KEY"
      }
    },
    "deepproxy": {
      "name": "DeepProxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:3001/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 64000,
            "output": 8000
          }
        },
        "deepseek-v4-flash-thinking": {
          "name": "DeepSeek V4 Flash Thinking",
          "limit": {
            "context": 64000,
            "output": 8000
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 64000,
            "output": 8000
          }
        },
        "deepseek-v4-pro-thinking": {
          "name": "DeepSeek V4 Pro Thinking",
          "limit": {
            "context": 64000,
            "output": 8000
          }
        }
      }
    },
    "kimiproxy": {
      "name": "KimiProxy",
      "npm": "@ai-sdk/openai-compatible",
