{
  "name": "headroom-openrouter",
  "description": "Headroom proxy (localhost:8787) → OpenRouter free models",
  "opencode": {
    "model": "headroom/openrouter/free",
    "small_model": "headroom/openrouter/free",
    "agent": {
      "build": { "model": "headroom/openrouter/free" },
      "plan": { "model": "headroom/openrouter/free" }
    },
    "provider": {
      "headroom": {
        "name": "Headroom → OpenRouter",
        "npm": "@ai-sdk/openai-compatible",
        "options": {
          "baseURL": "http://localhost:8787/v1",
          "apiKey": "$OPENROUTER_API_KEY"
        },
        "models": {
          "openrouter/free": {
            "name": "OpenRouter Free (auto-route)",
            "limit": {
              "context": 128000,
              "output": 16384
            }
          },
          "deepseek-v4-flash-free": {
            "name": "DeepSeek V4 Flash Free",
            "limit": {
              "context": 64000,
              "output": 8000
            }
          },
          "nemotron-3-ultra-free": {
            "name": "Nemotron 3 Ultra Free",
            "limit": {
              "context": 128000,
              "output": 16384
            }
          },
          "mimo-v2.5-free": {
            "name": "MiMo V2.5 Free",
            "limit": {
              "context": 128000,
              "output": 8192
            }
          }
        }
      }
    }
  },
  "omo": {
    "default_model": "headroom/openrouter/free",
    "agents": {
      "oracle": "headroom/openrouter/free",
      "prometheus": "headroom/openrouter/free"
    },
    "categories": {
      "ultrabrain": "headroom/openrouter/free",
      "quick": "headroom/openrouter/free",
      "unspecified-low": "headroom/openrouter/free"
    }
  },
  "prelaunch": [
    {
      "name": "Headroom Proxy",
      "check": { "tcp": 8787 },
      "start": "headroom proxy --port 8787 --openai-api-url https://openrouter.ai/api/v1",
      "timeoutMs": 30000
    }
  ],
  "env": {}
}
